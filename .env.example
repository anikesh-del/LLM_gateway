# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=llm_gateway
DB_USER=gateway_user
DB_PASSWORD=gateway_password

# Gateway Admin Secret (used to protect /admin endpoints like virtual key generation)
ADMIN_API_KEY=admin-secret-change-me-in-production

# Upstream LLM Provider Configuration (Primary)
PRIMARY_PROVIDER_API_KEY=your_primary_provider_api_key_here
PRIMARY_PROVIDER_BASE_URL=https://api.openai.com/v1

# Upstream LLM Provider Configuration (Secondary / Fallback)
FALLBACK_PROVIDER_API_KEY=your_fallback_provider_api_key_here
FALLBACK_PROVIDER_BASE_URL=https://api.groq.com/openai/v1

