# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=llm_gateway
DB_USER=gateway_user
DB_PASSWORD=gateway_password

# Gateway Admin Secret (used to protect /admin endpoints like virtual key generation)
ADMIN_API_KEY=admin-secret-change-me-in-production

# Upstream Primary Provider (e.g. Groq)
PRIMARY_PROVIDER_API_KEY=your_groq_api_key_here
PRIMARY_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=llama-3.1-8b-instant

# Upstream Fallback Provider (e.g. Google Gemini)
FALLBACK_PROVIDER_API_KEY=your_gemini_api_key_here
FALLBACK_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_MODEL=gemini-1.5-flash

# Currency & Estimation Settings
USD_INR=84.00
DEFAULT_MAX_TOKENS=512
MAX_TOKENS_CEILING=4096
